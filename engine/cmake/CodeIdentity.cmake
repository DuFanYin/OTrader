# Targets and every target they link that compiles something of its own.
function(optra_linked_targets out)
  set(todo ${ARGN})
  set(seen)
  set(found)
  while(todo)
    list(POP_FRONT todo target)
    if(target MATCHES "^\\$<LINK_ONLY:(.+)>$")
      set(target ${CMAKE_MATCH_1})
    endif()
    if(NOT TARGET ${target} OR target IN_LIST seen)
      continue()
    endif()
    list(APPEND seen ${target})
    get_target_property(aliased ${target} ALIASED_TARGET)
    if(aliased)
      list(APPEND todo ${aliased})
      continue()
    endif()
    get_target_property(imported ${target} IMPORTED)
    if(imported)
      continue()
    endif()
    get_target_property(type ${target} TYPE)
    if(NOT type STREQUAL "INTERFACE_LIBRARY")
      list(APPEND found ${target})
    endif()
    foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
      get_target_property(linked ${target} ${property})
      if(linked)
        list(APPEND todo ${linked})
      endif()
    endforeach()
  endwhile()
  set(${out} "${found}" PARENT_SCOPE)
endfunction()

# After a program links: <program>.code beside it, each group the hash of what its targets (with
# what they link) were compiled from: ENGINE (the trading core, the same in every program) and CORE
# (all a backtest is); in it as engine and core.
function(optra_code_identity program)
  cmake_parse_arguments(GROUP "" "" "ENGINE;CORE" ${ARGN})
  set(groups)
  foreach(group ENGINE CORE)
    if(GROUP_${group})
      string(TOLOWER ${group} name)
      optra_linked_targets(targets ${GROUP_${group}})
      set(objects)
      foreach(target ${targets})
        list(APPEND objects "$<JOIN:$<TARGET_OBJECTS:${target}>,$<COMMA>>")
      endforeach()
      list(JOIN objects "," objects)
      list(APPEND groups "${name}:${objects}")
    endif()
  endforeach()
  list(JOIN groups "|" groups)
  add_custom_command(TARGET ${program} POST_BUILD
    COMMAND ${CMAKE_COMMAND} "-DOUT=$<TARGET_FILE:${program}>.code" "-DGROUPS=${groups}"
            "-DENGINE=${CMAKE_SOURCE_DIR}" "-DSTRATEGY=${CMAKE_SOURCE_DIR}/../strategy"
            -P ${CMAKE_SOURCE_DIR}/cmake/code_identity.cmake
    VERBATIM)
endfunction()
